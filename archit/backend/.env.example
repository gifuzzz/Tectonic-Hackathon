# Copy to .env and fill in what you need. Everything is optional.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origins allowed to call the API when DJANGO_DEBUG=0 (in debug, all origins are allowed)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database: leave empty to use SQLite (db.sqlite3). For PostgreSQL:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/sdworx

# Google Drive (defaults: ../credentials.json and ./token.json)
# GOOGLE_CREDENTIALS_FILE=../credentials.json
# GOOGLE_TOKEN_FILE=token.json

# OpenAI: leave empty to use rule-based enrichment and keyword search only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
